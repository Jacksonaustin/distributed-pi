        "alignValue": "center",
        "legend": {
          "showLegend": false
        }
      },
      "transparent": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Leader heartbeat age (Raspberry Pis)",
      "description": "Seconds since each Pi heard a valid leader heartbeat (0 on the leader). Past the dashed 6 s line a candidate may start an election.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "election_leader_heartbeat_age_seconds{role!=\"witness\"} and on(instance) up{job=\"election\"} == 1",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#E02F44",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transparent": false
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Elections started",
      "description": "Elections started, totalled over members (as reported in the time range; a member's own count restarts at 0 when its app restarts).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
