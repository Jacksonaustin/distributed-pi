{
  "uid": "election-cluster",
  "title": "Election cluster",
  "tags": [
    "lab6"
  ],
  "description": "Leader election cluster: 4 Raspberry Pis + witness",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "description": "How many reachable members report themselves as leader. Exactly one is healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(election_is_leader == 1 and on(instance) up{job=\"election\"} == 1) or vector(0)",
          "legendFormat": "leaders",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO LEADER: no candidate can reach a majority",
                  "color": "#E02F44",
                  "index": 0
                },
                "1": {
                  "text": "ONE LEADER: cluster healthy",
                  "color": "#56A64B",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": 1000,
                "result": {
                  "text": "MULTIPLE LEADERS: investigate",
                  "color": "#E02F44",
                  "index": 20
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E8E"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 44,
          "titleSize": 14
        }
      },
      "transparent": false
    },
    {
      "id": 2,
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current leader",
      "description": "The reachable member whose election_is_leader is 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "election_is_leader == 1 and on(instance) up{job=\"election\"} == 1",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#56A64B"
          },
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 56,
          "titleSize": 14
        }
      },
      "transparent": false
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Term",
      "description": "Highest term among reachable members.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(election_term and on(instance) up{job=\"election\"} == 1)",
          "legendFormat": "term",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 56,
          "titleSize": 14
        }
      },
      "transparent": false
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Quorum",
      "description": "Whether the leader is hearing from enough voters to keep leading.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 13,
        "y": 5,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(election_has_quorum and on(instance) up{job=\"election\"} == 1) or vector(0)",
          "legendFormat": "quorum",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NONE",
                  "color": "#E02F44",
                  "index": 0
                },
                "1": {
                  "text": "AVAILABLE",
                  "color": "#56A64B",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E8E"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 32,
          "titleSize": 14
        }
      },
      "transparent": false
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Votes needed to lead",
      "description": "Votes a candidate needs, voters in the member list, and voters reachable now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(election_votes_needed)",
          "legendFormat": "needed",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(election_voters)",
          "legendFormat": "voters",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"election\"} == 1 and on(instance) election_voters)",
          "legendFormat": "voters up",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 32,
          "titleSize": 14
        }
      },
      "transparent": false
    },
    {
      "id": 7,
      "type": "row",
      "title": "Members",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "",
      "description": "One row per member. Reachable = Prometheus can read its /metrics right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, role) (up{job=\"election\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, role) (election_state_code and on(instance) up{job=\"election\"} == 1)",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, role) (election_term and on(instance) up{job=\"election\"} == 1)",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, role) (election_leader_heartbeat_age_seconds and on(instance) up{job=\"election\"} == 1)",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reachable"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "#E02F44",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "#56A64B",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FOLLOWER",
                        "color": "#3274D9",
                        "index": 0
                      },
                      "1": {
                        "text": "CANDIDATE",
                        "color": "#FF9830",
                        "index": 1
                      },
                      "2": {
                        "text": "LEADER",
                        "color": "#56A64B",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Heartbeat age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#56A64B",
                      "value": null
                    },
                    {
                      "color": "#FF9830",
                      "value": 3
                    },
                    {
                      "color": "#E02F44",
                      "value": 6
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "transparent": true,
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {
              "node": 0,
              "role": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "node": "Node",
              "role": "Role",
              "Value #A": "Reachable",
              "Value #B": "State",
              "Value #C": "Term",
              "Value #D": "Heartbeat age"
            }
          }
        }
      ]
    },
    {
