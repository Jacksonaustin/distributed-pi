          },
          "expr": "election_state_code and on(instance) up{job=\"election\"} == 1",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FOLLOWER",
